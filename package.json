{
  "name": "raw-desktop",
  "productName": "RAW Management",
  "version": "1.0.1",
  "description": "RAW Management для Windows",
  "author": "RAW",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kz.raw.management",
    "productName": "RAW Management",
    "copyright": "RAW",
    "files": ["main.js", "preload.js", "offline.html", "build/**", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "RAW-Management-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RAW Management",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1049"
    },
    "publish": [{ "provider": "github", "owner": "RAWGym", "repo": "raw-desktop", "releaseType": "release" }]
  }
}
